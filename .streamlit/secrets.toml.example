# Streamlit Community Cloud -> app settings -> Secrets. Paste the contents.
#
# app/ui.py copies these into os.environ before settings is constructed, which is
# how pydantic-settings sees them: there is no .env file on that host.
#
# Do NOT commit the real file. .streamlit/secrets.toml is git-ignored.

STREAMLIT_CLOUD = "1"

# Optional. Without it every offline feature still works and the assistant
# replays the recorded evaluation queries, labelled as cached demo output.
ANTHROPIC_API_KEY = ""

# Strongly recommended whenever a key is set on a public URL.
DEMO_MODE = "1"
DEMO_LLM_CALL_BUDGET = "8"
