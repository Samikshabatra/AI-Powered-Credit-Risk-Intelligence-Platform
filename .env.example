# ---- Anthropic ----
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SQL generation + agent routing (strong tool-calling)
SQL_MODEL=claude-sonnet-5
# Cheap pass: turning SQL rows into prose, reason-code phrasing
SUMMARY_MODEL=claude-haiku-4-5
MAX_TOKENS=2048
ENABLE_PROMPT_CACHING=true
# Note: there is deliberately no TEMPERATURE setting. The Messages API in the
# anthropic 1.x SDK does not accept one, so determinism for SQL generation comes
# from the prompt (pinned semantic layer + worked exemplars), not from sampling.

# ---- Paths (container-friendly; override for local runs) ----
DATA_DIR=data
RAW_DIR=data/raw
PROCESSED_DIR=data/processed
MODEL_DIR=models
REPORT_DIR=reports
SQLITE_PATH=data/credit_risk.db

# ---- Talk-to-Data guardrails ----
SQL_ROW_LIMIT=200
SQL_MAX_RETRIES=2
SQL_TIMEOUT_SECONDS=30

# ---- ML ----
RANDOM_SEED=42
HOLDOUT_FRACTION=0.2
VALID_FRACTION=0.1
CALIB_FRACTION=0.1
# Cost matrix: fraction of AMT_CREDIT lost per error type
LGD_RATE=0.45
MARGIN_RATE=0.08

# ---- Logging ----
LOG_LEVEL=INFO
